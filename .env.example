# Environment Variables for Gym Slot Booking System
# Copy this file to .env and fill in your values

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ─── JWT Secret ────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_before_deploying

# ─── Database ──────────────────────────────────────────────────────────────────
# SQLite database file path (relative to project root)
DB_PATH=./server/gym.db

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Allowed frontend origin (set to your deployed frontend URL in production)
CLIENT_ORIGIN=http://localhost:3000

# ─── Node Environment ──────────────────────────────────────────────────────────
NODE_ENV=development
